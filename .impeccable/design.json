  "narrative": {
    "northStar": "The Bear's Den at Night",
    "overview": "A dark, quiet room where the show's own art is the only bright thing, and the bear's brown marks the one thing to do next. The ground is a violet-tinted near-black, cards sit one tonal step above it, and every bit of colour beyond the brown carries a fixed meaning about words and ease. The interface steps back so posters and scenes do the talking.\n\nDensity is calm on phone and tablet (Material 3 defaults, generous 16dp gutters) and lean-back on TV (32dp edges, a focused card that grows). One design spans three inputs: touch on phone and tablet, D-pad focus on TV, with the same colours, the same resume-first order and the same poster/neutral-poster pairing everywhere.\n\nThe system is plain on purpose: no custom typeface, no decorative ornament, no shadows. Material 3 on mobile and Compose for TV supply the components; kumapie supplies the palette, the radii and the rules about what may be brown or coloured.",
    "keyCharacteristics": [
      "Violet-black ground, one-step-lighter surfaces, depth by tone only.",
      "Bear brown is the single action/progress/selection accent.",
      "Word and level colours are information, never decoration.",
      "Show art carries the colour; missing art gets a muted name-hued neutral poster, never an episode frame.",
      "Resume first: the last episode is the largest thing on Home on every device."
    ],
    "rules": [
      {
        "name": "The One Brown Rule",
        "body": "Bear brown means \"act here / you are here / how far along\": play, progress, the current selection, focus. Nothing decorative is brown, and secondary actions (the tablet rail's \"+\") stay surface-coloured so play is the first brown on screen.",
        "section": "colors"
      },
      {
        "name": "The Colour Means Something Rule",
        "body": "Green, yellow, red and blue are reserved for word state and level/ease; orange only marks counts and \"today\" in stats and help. They never appear as decoration, category colour or chrome.",
        "section": "colors"
      },
      {
        "name": "The Material Roles Rule",
        "body": "Use the Material type roles by name; never set raw sizes on Home text. The one raw size is the TV text field (20sp).",
        "section": "typography"
      },
      {
        "name": "The Tone-Not-Shadow Rule",
        "body": "No drop shadows on Home surfaces; a container is one tonal step up from its ground, and focus is shown by scale and border.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** put the last episode first and largest on every device, with its play control in bear brown.",
      "**Do** use Dusk Surface for every container and keep secondary actions on it, so brown stays for play, progress and selection.",
      "**Do** draw a neutral poster under every poster image.",
      "**Do** switch to the rail only at 600dp wide and 560dp tall, and split resume/library only from 840dp.",
      "**Do** leave room for TV focus growth (10%) in row padding."
    ],
    "donts": [
      "**Don't** use green, yellow, red or blue for anything but word state and level/ease, or orange as a word colour.",
      "**Don't** show an episode frame where a poster is missing; unseen episode pictures stay blurred.",
      "**Don't** add drop shadows; depth is tonal.",
      "**Don't** let the resume card grow past 600dp wide in one column."
    ]
  }
}
