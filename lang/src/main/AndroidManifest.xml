<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dictionaries, models and recordings are downloaded; downloads run as a foreground job. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Sync with the other devices (DeviceSync): one answers the others on the home Wi-Fi, with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Reading and mining cards in kuma3 Anki (or AnkiDroid): see AnkiCards.kt. -->
    <uses-permission android:name="io.github.pedrubik2000.kuma3.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.debug.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <queries>
        <provider android:authorities="io.github.pedrubik2000.kuma3.flashcards" />
        <provider android:authorities="com.ichi2.anki.debug.flashcards" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
    </queries>

    <application>
        <service
            android:name="io.github.pedrubik2000.kumapie.lang.SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Answers sync requests from the user's own devices on the local network" />
        </service>
        <receiver android:name="io.github.pedrubik2000.kumapie.lang.SyncBoot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Mined cards' clip and audio, lent to kuma3 Anki while it copies them into its media folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
