   "name": "🇩🇪 MvJ",
   "qfmt": "<div id=\"new-badge\" style=\"display:none;position:absolute;top:8px;left:8px;z-index:5;padding:2px 8px;border-radius:999px;background:#3b82f6;color:#fff;font:700 12px sans-serif\">NEW</div>\n<script>\n(async () => {\n    if (typeof AnkiDroidJS === \"undefined\") return;\n    try {\n        const api = new AnkiDroidJS({ version: \"0.0.3\", developer: \"Pedrubik2000\" });\n        if ((await api.ankiGetCardType()).value === 0) document.getElementById(\"new-badge\").style.display = \"\";\n    } catch (e) {}\n})();\n</script>\n<div class=\"plain front\">\n<div class=\"media\" id=\"media\"></div>\n<div class=\"ask\" id=\"tap\">🎧 listen</div>\n<div id=\"raw-word\" style=\"display:none\">{{Word}}</div>\n<div data-audio=\"word\" id=\"a-word\" style=\"display:none\">{{Word Audio}}</div>\n<div data-audio=\"sentence\" id=\"a-sent\" style=\"display:none\">{{Video}}</div>\n</div>\n<script>\n(function () {\n  var back = !!document.querySelector('.plain.back');\n  var files = function (id) {\n    var el = document.getElementById(id), out = [];\n    (el ? el.textContent : '').replace(/\\[(?:audio|sound):\\s*([^\\]]+?)\\s*\\]/g, function (m, f) { out.push(f); });\n    return out;\n  };\n  var word = files('a-word'), sent = files('a-sent');\n  var clip = sent.filter(function (f) { return /\\.(webm|mp4)$/i.test(f); })[0];\n  var sentAudio = sent.filter(function (f) { return f !== clip; });\n  var cur = null;\n  function stop() { if (cur) { cur.pause(); cur = null; } if (window.__v) window.__v.pause(); }\n  // One player for every sound; Anki XP wraps this to know when the word audio has played.\n  window.__playMobile = function (src) {\n    return new Promise(function (done) {\n      stop();\n      var a = new Audio(src); cur = a;\n      a.onended = a.onerror = function () { done(); };\n      var p = a.play(); if (p && p.catch) p.catch(done);\n    });\n  };\n  var media = document.getElementById('media'), v = null;\n  if (clip && media) {\n    v = document.createElement('video'); window.__v = v;\n    v.src = clip; v.preload = 'auto'; v.playsInline = true; v.setAttribute('playsinline', '');\n    v.disablePictureInPicture = true;\n    v.poster = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';\n    media.appendChild(v);\n    if (back) v.addEventListener('loadedmetadata', function () { try { v.currentTime = Math.max(0, v.duration - 0.05); } catch (e) {} });\n    v.addEventListener('click', function () { if (v.paused) playClip(); else v.pause(); });\n  }\n  function playClip() {\n    return new Promise(function (done) {\n      if (!v) return done();\n      stop(); v.currentTime = 0; v.onended = function () { done(); };\n      var p = v.play(); if (p && p.catch) p.catch(done);\n    });\n  }\n  function chain(list) {\n    return list.reduce(function (p, f) { return p.then(function () { return window.__playMobile(f); }); }, Promise.resolve());\n  }\n  function playSentence() { return chain(sentAudio).then(function () { return back ? null : playClip(); }); }\n  if (back) {\n    // Japanese word line: 届く[とどく]:0- -> the word, its reading with the pitch drawn over it (line over high\n    // morae, drop after the accented one; as kumapie's popup) and [n]. Big when the card has no sentence.\n    var wl = document.getElementById('word');\n    var wm = /^\\s*([^\\[:]+?)\\s*(?:\\[([^\\]]+)\\])?\\s*(?::\\s*(\\d+))?[\\d,\\s-]*$/.exec((document.getElementById('raw-word') || {}).textContent || '');\n    if (wl && wm) {\n      var kana = wm[2] || wm[1], n = wm[3] == null ? null : +wm[3], morae = [];\n      for (var i = 0; i < kana.length; i++) {\n        if ('ゃゅょぁぃぅぇぉャュョァィゥェォ'.indexOf(kana[i]) >= 0 && morae.length) morae[morae.length - 1] += kana[i];\n        else morae.push(kana[i]);\n      }\n      var hi = function (i) { return n === 0 ? i > 0 : n === 1 ? i === 0 : i >= 1 && i < n; };\n      var pr = morae.map(function (m, i) {\n        var c = n == null ? '' : (hi(i) ? ' h' : '') + (n > 0 && i === n - 1 ? ' d' : '');\n        return '<span class=\"m' + c + '\">' + m + '</span>';\n      }).join('');\n      wl.innerHTML = (wm[2] ? '<span class=\"w\">' + wm[1] + '</span>' : '') + '<span class=\"pr\">' + pr + '</span>' +\n        (n == null ? '' : '<span class=\"pn\">[' + n + ']</span>');\n      var st = document.getElementById('sentence');\n      if (!st || !st.textContent.trim()) wl.className += ' big';\n    }\n    // Sentence: word highlighted (unless the field already bolds it), MvJ furigana \" 漢字[かんじ]\" as ruby.\n    var s = document.getElementById('sentence');\n    if (s) {\n      var raw = (document.getElementById('raw-word') || {}).textContent || '';\n      var w = raw.split('[')[0].replace(/:[\\d,\\s-]*$/, '').trim();\n      var html = s.innerHTML;\n      if (w && !/<b>/i.test(html)) {\n        var esc = w.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n        html = html.replace(new RegExp('(^|[^\\\\p{L}])(' + esc + ')(?![\\\\p{L}])', 'iu'), '$1<b>$2</b>');\n      }\n      s.innerHTML = html.replace(/ ?([^ >\\[\\]]+)\\[([^\\]→]+)\\]/g, '<ruby>$1<rt>$2</rt></ruby>');\n      s.querySelectorAll('b').forEach(function (b) { b.className = 't'; b.onclick = function (e) { e.stopPropagation(); chain(word); }; });\n      s.onclick = function () { chain(sentAudio).then(function () { if (!sentAudio.length) playClip(); }); };\n    }\n    chain(sentAudio);\n  } else {\n    var tap = document.getElementById('tap');\n    if (tap) tap.onclick = function () { chain(word).then(playSentence); };\n    chain(word).then(playSentence);\n  }\n})();\n</script>",
