 "css": ".card {\n  font-family: \"Segoe UI\", -apple-system, sans-serif;\n  font-size: 22px;\n  text-align: center;\n  color: #222;\n  background: #fafafa;\n}\n.card.nightMode { color: #e8e8e8; background: #1c1c1c; }\n.plain { max-width: 720px; margin: 0 auto; padding: 12px 16px; }\n.plain .media video { max-width: 100%; max-height: 42vh; border-radius: 10px; background: #000; }\n.plain .image img { max-height: 42vh; max-width: 92%; height: auto; border-radius: 10px; }\n.plain .ask { font-size: 15px; color: #888; margin-top: 30px; }\n.plain .sentence { font-size: 22px; margin-top: 14px; }\n.plain .t { color: #c2410c; font-weight: bold; }\n.card.nightMode .plain .t { color: #ffd166; }\n.plain .english { font-size: 17px; color: #666; margin-top: 6px; }\n.card.nightMode .plain .english { color: #b5b5b5; }\n.plain .def { font-size: 17px; color: #2563eb; margin-top: 16px; }\n.plain .def b { font-weight: normal; }\n.card.nightMode .plain .def { color: #8ab4f8; }\n.plain .def .gram { display: inline-block; margin-top: 6px; font-size: 15px; color: #888; }\n.plain .word { margin-top: 12px; font-size: 18px; }\n.plain .word.big { font-size: 34px; margin-top: 30px; }\n.plain .word .w { margin-right: 10px; }\n.plain .word .pr { display: inline-block; color: #666; }\n.card.nightMode .plain .word .pr { color: #b5b5b5; }\n.plain .word .m { position: relative; display: inline-block; padding-top: 3px; }\n.plain .word .m.h { border-top: 2px solid #c2410c; }\n.plain .word .m.d::after { content: \"\"; position: absolute; right: 0; top: 0; height: 45%; border-right: 2px solid #c2410c; }\n.card.nightMode .plain .word .m.h, .card.nightMode .plain .word .m.d::after { border-color: #ffd166; }\n.plain .word .pn { margin-left: 6px; font-size: 0.7em; color: #888; }\n.plain .mono { font-size: 15px; color: #888; margin-top: 12px; }\n.plain .mono summary { font-size: 13px; color: #aaa; }\n",
